# HTTP proxy (Webshare rotating, or any other HTTP/HTTPS/SOCKS proxy)
PROXY_SCHEME=http
PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional: full proxy URL instead of the fields above
# PROXY_URL=http://username:password@host:80

PROXY_CHECK_URL=https://ipv4.webshare.io/

# camoufox | playwright | curl_cffi | httpx
# camoufox is a real Firefox fingerprint and is the most reliable against Cloudflare
HTTP_BACKEND=camoufox
HTTP_TIMEOUT_SECONDS=60
HTTP_RETRIES=1
HTTP_RETRY_DELAY_SECONDS=2
HTTP_HEADLESS=true

# Same database as chain-store-backend
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boofstore_db
DB_USERNAME=root
DB_PASSWORD=

# Matches Laravel config/product.php and DecathlonBrandService defaults
DEFAULT_STOCK=10
DEFAULT_USER_ID=1
DEFAULT_COLOR_ID=1
DEFAULT_BRAND_SLUG=decathlon

# HTTP API used by chain-store-backend / Filament
# PRODUCT_SCRAPER_TOKEN=
API_HOST=0.0.0.0
API_PORT=8000
